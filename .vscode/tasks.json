{
  "version": "2.0.0",
  "tasks": [
    { "label": "Check: build + test", "type": "shell", "command": "npm test", "group": { "kind": "test", "isDefault": true }, "problemMatcher": ["$tsc"] },
    { "label": "Check: format + lint", "type": "shell", "command": "npm run format:check && npm run lint", "problemMatcher": [] },
    { "label": "Check: decoys lint + leak check + manifest", "type": "shell", "command": "npm run decoys:lint && npm run leak:check && npm run manifest:check", "problemMatcher": [] },
    { "label": "Format: write", "type": "shell", "command": "npm run format", "problemMatcher": [] },
    { "label": "Build", "type": "shell", "command": "npm run build", "group": { "kind": "build", "isDefault": true }, "problemMatcher": ["$tsc"] },
    { "label": "Validate: FHIR (HRex)", "type": "shell", "command": "[ -f .tools/validator_cli.jar ] || npm run validator:get; npm run validate:fhir", "problemMatcher": [] },
    { "label": "Score", "type": "shell", "command": "npm run score", "problemMatcher": [] },
    { "label": "Report", "type": "shell", "command": "npm run report", "problemMatcher": [] },
    { "label": "Spend: check", "type": "shell", "command": "npm run spend:check", "problemMatcher": [] },
    { "label": "Preview: dev console", "type": "shell", "command": "npm run console", "isBackground": true, "problemMatcher": [], "presentation": { "panel": "dedicated", "reveal": "always" } },
    { "label": "Preview: local $member-match endpoint (:8650)", "type": "shell", "command": "npm run serve", "isBackground": true, "problemMatcher": [], "presentation": { "panel": "dedicated", "reveal": "always" } },
    { "label": "Codex: review diff", "type": "shell", "command": "codex review", "problemMatcher": [], "presentation": { "panel": "dedicated", "reveal": "always" } }
  ]
}
