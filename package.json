{
  "name": "member-match-decoy-lab",
  "version": "0.0.0",
  "description": "Synthetic $member-match decoy lab: plant near-duplicate decoys and score three matchers. Synthetic data only; not a production matching recommendation.",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "node scripts/test.mjs",
    "decoys:lint": "node scripts/decoys-lint.mjs",
    "leak:check": "python3 tools/check-neutrality.py",
    "convert": "npm run -s build && node scripts/convert.mjs",
    "validator:get": "mkdir -p .tools && curl -fL -o .tools/validator_cli.jar https://github.com/hapifhir/org.hl7.fhir.core/releases/download/7.0.4/validator_cli.jar",
    "validate:fhir": "npm run -s convert && bash scripts/validate-fhir.sh",
    "manifest:build": "npm run -s build && node scripts/manifest.mjs build",
    "manifest:check": "npm run -s build && node scripts/manifest.mjs check",
    "serve": "npm run -s build && node dist/src/serve.js",
    "spend:check": "npm run -s build && node dist/src/spend-cli.js",
    "llm:try": "npm run -s build && node dist/src/llm-try.js",
    "score": "npm run -s build && node dist/src/score-cli.js",
    "golden:update": "npm run -s build && node scripts/golden-update.mjs",
    "report": "npm run -s build && node dist/src/report-cli.js",
    "vendor:build": "npm run -s build && node scripts/vendor-build.mjs",
    "ui:build": "npm run -s build && tsc -p tsconfig.ui.json && node scripts/ui-build.mjs",
    "console": "npm run -s build && mcp-tool-console",
    "format": "prettier --write \"**/*.{ts,mts,cts,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,cts,js,mjs,cjs}\"",
    "lint": "oxlint"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "oxlint": "1.92.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImOnFHIR/member-match-decoy-lab.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "mcp-tool-console": "git+https://github.com/ImOnFHIR/mcp-tool-console.git#9abccf770e512dbc9b24d980d22c1072cd96e723",
    "zod": "4.6.7"
  }
}
