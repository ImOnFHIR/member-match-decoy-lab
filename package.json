{
  "name": "member-match-decoy-lab",
  "version": "0.0.0",
  "description": "Synthetic $member-match decoy lab: plant near-duplicate decoys and score three matchers. Synthetic data only; not a production matching recommendation.",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "node scripts/test.mjs",
    "decoys:lint": "node scripts/decoys-lint.mjs",
    "leak:check": "python3 tools/check-neutrality.py",
    "convert": "npm run -s build && node scripts/convert.mjs",
    "validator:get": "mkdir -p .tools && curl -fL -o .tools/validator_cli.jar https://github.com/hapifhir/org.hl7.fhir.core/releases/download/7.0.4/validator_cli.jar",
    "validate:fhir": "npm run -s convert && bash scripts/validate-fhir.sh",
    "manifest:build": "npm run -s build && node scripts/manifest.mjs build",
    "manifest:check": "npm run -s build && node scripts/manifest.mjs check",
    "serve": "npm run -s build && node dist/src/serve.js",
    "spend:check": "npm run -s build && node dist/src/spend-cli.js",
    "llm:try": "npm run -s build && node dist/src/llm-try.js"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImOnFHIR/member-match-decoy-lab.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "zod": "4.6.7"
  }
}
