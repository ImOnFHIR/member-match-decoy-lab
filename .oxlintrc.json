{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".tools/**",
    "fixtures/**",
    "manifest/**",
    "decoys/**",
    "report/**"
  ],
  "rules": {
    "no-underscore-dangle": "off"
  }
}
